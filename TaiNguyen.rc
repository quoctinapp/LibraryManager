// ============================================================================
//  TaiNguyen.rc - danh sach "tai nguyen" (resource) NHUNG VAO BEN TRONG file exe
//  [GIAI THICH] Nho file nay, QuanLyThuVien.exe tu mang theo icon, manifest va 4 file du lieu mau 
//  -> chi can gui MOT file exe la chay duoc. Lan dau chay, exe tu giai nen du lieu mau ra thu muc data/ ben canh no.
//  Cong cu "windres" (di kem g++) bien file nay thanh build/TaiNguyen.o roi ghep vao exe. File nay chi dung chu khong dau de windres doc an toan.
// ============================================================================

// Icon cua file exe (hien trong File Explorer, thanh Taskbar, goc cua so)
IDI_UNG_DUNG ICON "data/icon.ico"

// Manifest: giao dien hien dai (Common Controls 6) + sac net tren man hinh DPI cao
1 24 "QuanLyThuVien.manifest"

// 4 file du lieu mau (RCDATA = du lieu tho, giu nguyen tung byte, UTF-8 co dau)
DL_ADMIN RCDATA "data/Admin.txt"
DL_SACH RCDATA "data/Sach.txt"
DL_BANDOC RCDATA "data/BanDoc.txt"
DL_PHIEUMUON RCDATA "data/PhieuMuon.txt"

// Thong tin hien trong Properties > Details cua file exe
1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "042a04b0"
        BEGIN
            VALUE "FileDescription", "Quan ly thu vien - Project 3"
            VALUE "ProductName", "Quan ly thu vien"
            VALUE "FileVersion", "2.0"
            VALUE "ProductVersion", "2.0"
            VALUE "Comments", "Do an Cau truc du lieu va Giai thuat C++ - Win32 API"
            VALUE "OriginalFilename", "QuanLyThuVien.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x042a, 1200
    END
END
